---
import "../../../src/styles/tokens.css";
import "../../../src/styles/base.css";
import "../styles/scvria.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SCVRIA Sofware",
  description = "Open-source software publisher and studio."
} = Astro.props;

const navigation = [
  { href: "/", label: "Home" },
  { href: "/software/", label: "Software" },
  { href: "/manifesto/", label: "Manifesto" },
  { href: "/community/", label: "Community" },
  { href: "/about/", label: "About" }
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="scvria-frame">
      <header class="scvria-header">
        <div class="scvria-bar">
          <a class="scvria-brand" href="/">SCVRIA Sofware</a>
          <span>public software surface</span>
        </div>

        <nav class="scvria-nav" aria-label="Primary navigation">
          <ul>
            {navigation.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </header>

      <main class="scvria-document">
        <slot />
      </main>

      <footer class="scvria-footer">
        <span>SCVRIA Sofware</span>
        <span>Bring the intelligence back to the people.</span>
      </footer>
    </div>
  </body>
</html>
