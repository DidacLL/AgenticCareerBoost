---
import ScvriaLayout from "../layouts/ScvriaLayout.astro";
---

<ScvriaLayout
  title="About — SCVRIA Sofware"
  description="About SCVRIA Sofware, an independent software studio and publisher founded and maintained by Dídac Llorens."
>
  <section class="scvria-page scvria-prose-page">
    <header class="scvria-page-header">
      <p class="scvria-eyebrow">Studio</p>
      <h1>About</h1>
      <p class="scvria-lead">
        SCVRIA Sofware is an independent software studio and publisher focused on open-source, user-first software.
      </p>
    </header>

    <div class="scvria-prose">
      <p>
        SCVRIA Sofware was founded and is operated and maintained by Dídac Llorens. It is presented as an independent publishing and development identity, not as a larger team or corporate organization.
      </p>
      <p>
        For Dídac's professional portfolio, background, and personal projects, visit <a href="https://didacll.github.io/">didacll.github.io</a> or <a href="https://github.com/DidacLL">Dídac's GitHub profile</a>.
      </p>
    </div>
  </section>
</ScvriaLayout>
