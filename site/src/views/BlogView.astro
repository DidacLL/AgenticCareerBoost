---
import { getCollection, getEntry, render } from "astro:content";
import ArticleRecord from "../components/ArticleRecord.astro";
import DocumentLayout from "../layouts/DocumentLayout.astro";
import { siteFor } from "../data/site";
import { contentId, defaultLocale, localizedEntries, type Locale } from "../lib/i18n";

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const site = siteFor(locale);
const page = await getEntry("pages", contentId("blog", locale));
if (!page) throw new Error(`Blog index content is missing for locale ${locale}.`);
const { Content } = await render(page);
const posts = localizedEntries(await getCollection("posts"), locale).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<DocumentLayout title={page.data.title} description={page.data.description} label={page.data.label} subtitle={page.data.subtitle} activeNav="blog" locale={locale} meta={[{ term: site.ui.records, value: String(posts.length) }]}>
  <section class="section-block"><h2>{site.ui.context}</h2><div class="section-content prose"><Content /></div></section>
  <section class="section-block"><h2>{site.ui.index}</h2><div class="section-content preview-list">{posts.map((post) => <ArticleRecord post={post} locale={locale} />)}</div></section>
</DocumentLayout>
