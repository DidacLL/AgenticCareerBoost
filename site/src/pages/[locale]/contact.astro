---
import ContactView from "../../views/ContactView.astro";
import { translatedLocales, type Locale } from "../../lib/i18n";

export function getStaticPaths() {
  return translatedLocales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
---

<ContactView locale={locale} />
