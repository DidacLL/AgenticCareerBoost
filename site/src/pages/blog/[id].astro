---
import { getCollection } from "astro:content";
import PostView from "../../views/PostView.astro";
import { localContentId, localizedEntries } from "../../lib/i18n";

export async function getStaticPaths() {
  const posts = localizedEntries(await getCollection("posts"), "en");
  return posts.map((post) => ({ params: { id: localContentId(post.id) }, props: { post } }));
}

const { post } = Astro.props;
---

<PostView post={post} locale="en" />
