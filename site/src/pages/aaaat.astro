---
const destination = "https://didacll.github.io/AAAAT/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={destination} />
    <title>AAAAT — Redirecting</title>
  </head>
  <body>
    <main>
      <p>AAAAT has moved to <a href={destination}>the AAAAT website</a>.</p>
    </main>
  </body>
</html>
