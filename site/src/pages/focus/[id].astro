---
import { getCollection, render } from "astro:content";
import ArticleRecord from "../../components/ArticleRecord.astro";
import ProjectPreview from "../../components/ProjectPreview.astro";
import DocumentLayout from "../../layouts/DocumentLayout.astro";
import { site } from "../../data/site";
import { paths } from "../../lib/paths";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const posts = await getCollection("posts");
  const focusViews = await getCollection("focus");
  return focusViews.map((focus) => ({ params: { id: focus.id }, props: { focus, projects, posts } }));
}

const { focus, projects, posts } = Astro.props;
const { Content } = await render(focus);
const relatedProjects = projects.filter((project) => focus.data.relatedProjectIds.includes(project.id)).sort((a, b) => a.data.order - b.data.order);
const relatedPosts = posts.filter((post) => focus.data.relatedPostIds.includes(post.id));
---

<DocumentLayout
  title={focus.data.title}
  description={focus.data.description}
  label={focus.data.label}
  subtitle={focus.data.subtitle ?? focus.data.description}
  activeNav="focus"
  meta={[{ term: "CV VIEW", href: paths.cv(focus.data.relatedCvId), label: focus.data.relatedCvId.toUpperCase() }]}
>
  <section class="section-block"><h2>{site.ui.context}</h2><div class="section-content prose"><Content /><p><a href={paths.cv(focus.data.relatedCvId)}>Open the related CV view →</a></p></div></section>
  <section class="section-block"><h2>{site.ui.relatedWork}</h2><div class="section-content preview-list">{relatedProjects.map((project) => <ProjectPreview project={project} compact />)}</div></section>
  {relatedPosts.length > 0 && <section class="section-block"><h2>{site.ui.relatedNotes}</h2><div class="section-content preview-list">{relatedPosts.map((post) => <ArticleRecord post={post} />)}</div></section>}
</DocumentLayout>