---
import { getCollection, getEntry, render } from "astro:content";
import ArtifactList from "../../components/ArtifactList.astro";
import ProjectLayout from "../../layouts/ProjectLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
const remoteSource = await getEntry("projectSources", project.id);
const { Content: LocalContent } = await render(project);
const remoteRender = remoteSource ? await render(remoteSource) : undefined;
const RemoteContent = remoteRender?.Content;
const remoteCover = remoteSource
  ? { src: remoteSource.data.coverUrl, alt: project.data.imageAlt }
  : undefined;
---

<ProjectLayout project={project} remoteCover={remoteCover}>
  {RemoteContent ? <RemoteContent /> : <LocalContent />}
  {project.id === "agentic-career-boost" && <ArtifactList slot="evidence" />}
</ProjectLayout>
