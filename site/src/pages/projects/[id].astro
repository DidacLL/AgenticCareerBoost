---
import { getCollection } from "astro:content";
import ProjectView from "../../views/ProjectView.astro";
import { localContentId, localizedEntries } from "../../lib/i18n";

export async function getStaticPaths() {
  const projects = localizedEntries(await getCollection("projects"), "en");
  return projects.map((project) => ({ params: { id: localContentId(project.id) }, props: { project } }));
}

const { project } = Astro.props;
---

<ProjectView project={project} locale="en" />
