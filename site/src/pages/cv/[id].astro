---
import { getCollection } from "astro:content";
import CvView from "../../views/CvView.astro";
import { localContentId, localizedEntries } from "../../lib/i18n";

export async function getStaticPaths() {
  const views = localizedEntries(await getCollection("cv"), "en");
  return views.map((cv) => ({ params: { id: localContentId(cv.id) }, props: { cv } }));
}

const { cv } = Astro.props;
---

<CvView cv={cv} locale="en" />
