---
import { getEntry, render } from "astro:content";
import DocumentLayout from "../layouts/DocumentLayout.astro";
import { site } from "../data/site";
import { asset, paths } from "../lib/paths";

const contact = await getEntry("pages", "contact");
if (!contact) throw new Error("Contact content is missing.");
const { Content } = await render(contact);
const channels = [
  ...site.contact.channels.map((item) => ({ ...item, external: true })),
  {
    id: "cv",
    label: "CV",
    href: paths.cv("ml"),
    description: site.cv.contactDescription,
    image: site.cv.logo,
    imageAlt: site.cv.logoAlt,
    external: false
  }
];
---

<DocumentLayout title={contact.data.title} description={contact.data.description} label={contact.data.label} subtitle={contact.data.subtitle} activeNav="contact">
  <section class="section-block">
    <h2>{site.ui.channel}</h2>
    <div class="section-content">
      <div class="prose"><Content /></div>
      <div class="channel-grid">
        {channels.map((channel) => (
          <a class="channel-card" href={channel.href} target={channel.external ? "_blank" : undefined} rel={channel.external ? "noopener noreferrer" : undefined}>
            <span class="channel-card__media"><img src={asset(channel.image)} alt={channel.imageAlt} loading="eager" decoding="async" /></span>
            <span class="channel-card__copy"><strong>{channel.label}</strong><span>{channel.description}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</DocumentLayout>
