---
import { getEntry, render } from "astro:content";
import DocumentLayout from "../layouts/DocumentLayout.astro";
import { site } from "../data/site";
import { paths } from "../lib/paths";

const contact = await getEntry("pages", "contact");
if (!contact) throw new Error("Contact content is missing.");
const { Content } = await render(contact);
---

<DocumentLayout title={contact.data.title} description={contact.data.description} label={contact.data.label} subtitle={contact.data.subtitle} activeNav="contact">
  <section class="section-block"><h2>{site.ui.channel}</h2><div class="section-content prose"><Content /><p><a href={paths.cv("ml")}>Open the web CV →</a></p></div></section>
</DocumentLayout>