---
import { getEntry, render } from "astro:content";
import DocumentLayout from "../layouts/DocumentLayout.astro";
import { paths } from "../lib/paths";
const contact=await getEntry("pages","contact");
if(!contact) throw new Error("Contact content is missing.");
const { Content }=await render(contact);
---
<DocumentLayout title="Contact — Dídac Llorens" description={contact.data.description} label="CONTACT" subtitle="Barcelona · software engineering · public work." activePath="/contact/">
 <section class="os-panel"><Content /><p><a href={paths.cv("ml")}>Open the web CV.</a></p></section>
</DocumentLayout>
