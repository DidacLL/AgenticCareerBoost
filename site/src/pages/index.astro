---
import { getCollection, getEntry, render } from "astro:content";
import Gallery from "../components/Gallery.astro";
import DocumentLayout from "../layouts/DocumentLayout.astro";
import { site } from "../data/site";
import { asset, paths } from "../lib/paths";

const home = await getEntry("pages", "home");
if (!home) throw new Error("Home content is missing.");
const { Content } = await render(home);
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featuredNav = site.navigation.filter((item) => ["cv", "projects", "blog"].includes(item.id));
const slides = [
  {
    ...site.monitor.profile,
    image: asset(site.monitor.profile.image),
    links: site.monitor.profile.links.map((link) => ({ label: link.label, href: paths.nav(link.navId) }))
  },
  ...projects.map((project) => ({
    label: `${project.data.label ?? "PROJECT"} / ${project.data.status ?? "public record"}`,
    title: project.data.title,
    image: asset(project.data.image),
    alt: project.data.imageAlt,
    lines: [project.data.summary, project.data.tags.join(" · ")],
    links: [{ label: "Open project", href: paths.project(project.id) }],
    caption: "project / selected work",
    contain: true
  }))
];
---

<DocumentLayout title={home.data.title} description={home.data.description} label={home.data.label} subtitle={home.data.subtitle} activeNav="home">
  <section class="home-intro">
    <div class="home-copy">
      <div class="prose"><Content /></div>
      {home.data.facts && <dl class="facts-list">{home.data.facts.map((item) => <div><dt>{item.term}</dt><dd>{item.value}</dd></div>)}</dl>}
    </div>
    <Gallery slides={slides} />
  </section>

  <section class="section-block">
    <h2>{site.ui.index}</h2>
    <div class="section-content route-list">
      {featuredNav.map((item) => (
        <a href={paths.nav(item.id)}><span>{item.kicker}</span><strong>{item.label}</strong><p>{item.description}</p></a>
      ))}
    </div>
  </section>
</DocumentLayout>