---
import { getEntry, render } from "astro:content";
import DocumentLayout from "../layouts/DocumentLayout.astro";
import { site } from "../data/site";
import { paths } from "../lib/paths";

const page = await getEntry("pages", "not-found");
if (!page) throw new Error("404 content is missing.");
const { Content } = await render(page);
---

<DocumentLayout title={page.data.title} description={page.data.description} label={page.data.label} subtitle={page.data.subtitle} noindex>
  <section class="section-block"><h2>{site.ui.return}</h2><div class="section-content prose"><Content /><p><a href={paths.home()}>{site.ui.returnHome}</a></p></div></section>
</DocumentLayout>
