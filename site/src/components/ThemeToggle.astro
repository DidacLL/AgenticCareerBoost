---
import { siteFor } from "../data/site";
import { defaultLocale, type Locale } from "../lib/i18n";

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const site = siteFor(locale);
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-label-dark={site.theme.dark}
  data-label-light={site.theme.light}
  aria-label={site.theme.toggle}
  aria-pressed="false"
  transition:persist={`theme-toggle-${locale}`}
>
  {site.theme.dark}
</button>

<script>
  import "../scripts/theme.js";
</script>
