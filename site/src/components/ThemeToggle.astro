---
import { site } from "../data/site";
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-label-dark={site.theme.dark}
  data-label-light={site.theme.light}
  aria-label={site.theme.toggle}
  aria-pressed="false"
  transition:persist="theme-toggle"
>
  {site.theme.dark}
</button>

<script>
  import "../scripts/theme.js";
</script>