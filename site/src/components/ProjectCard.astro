---
import type { CollectionEntry } from "astro:content";
import { asset, paths } from "../lib/paths";
const { project } = Astro.props as { project: CollectionEntry<"projects"> };
---
<a class="project-card" href={paths.project(project.id)}>
  <img src={asset(project.data.image)} alt={project.data.imageAlt} loading="lazy" />
  <div>
    <p class="eyebrow">{project.data.label ?? "project"}</p>
    <h3>{project.data.title}</h3>
    <p>{project.data.summary}</p>
    <ul class="tags">{project.data.tags.map((tag) => <li>{tag}</li>)}</ul>
  </div>
</a>
