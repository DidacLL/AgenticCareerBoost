---
import reports from "../data/reports.json";
import { asset } from "../lib/paths";
---

<section class="section-block">
  <h3>EVIDENCE</h3>
  <div class="section-content preview-list">
    {reports.map((report) => (
      <a class="preview-row" href={asset(`files/reports/${report.file}`)}>
        <span class="article-date">PDF</span>
        <span class="preview-row__copy">
          <h3>{report.title} <span aria-hidden="true">↗</span></h3>
          <p>{report.description}</p>
        </span>
      </a>
    ))}
  </div>
</section>
