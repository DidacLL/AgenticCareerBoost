---
import { getEntry, render } from "astro:content";
import { contentId, defaultLocale, type Locale } from "../lib/i18n";

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const footer = await getEntry("pages", contentId("footer", locale));
if (!footer) throw new Error(`Footer content is missing for locale ${locale}.`);
const { Content } = await render(footer);
---

<footer class="site-footer" aria-label={footer.data.title}>
  <Content />
</footer>
