---
import { site } from "../data/site";

type SlideLink = { label: string; href: string; external?: boolean };
type Slide = {
  label: string;
  title: string;
  image: string;
  alt: string;
  lines: string[];
  links: SlideLink[];
  caption: string;
  contain?: boolean;
};

const { slides } = Astro.props as { slides: Slide[] };
const first = slides[0];
if (!first) throw new Error("Monitor requires at least one slide.");
---

<figure
  class="monitor"
  data-monitor
  data-expanded="false"
  data-monitor-slides={JSON.stringify(slides)}
  aria-label={site.monitor.label}
>
  <div class="monitor-toolbar">
    <button type="button" data-monitor-prev aria-label={site.monitor.previous}>←</button>
    <span class="monitor-channel"><span data-monitor-position>01</span> / {String(slides.length).padStart(2, "0")}</span>
    <button type="button" data-monitor-next aria-label={site.monitor.next}>→</button>
    <button
      type="button"
      class="monitor-expand"
      data-monitor-expand
      data-label-expand={site.monitor.expand}
      data-label-collapse={site.monitor.collapse}
      aria-expanded="false"
    >{site.monitor.expand}</button>
  </div>

  <div class:list={["monitor-screen", { "is-contained": first.contain }]} data-monitor-screen>
    <img data-monitor-image src={first.image} alt={first.alt} decoding="async" />
    <div class="monitor-scanlines" aria-hidden="true"></div>
    <div class="monitor-vignette" aria-hidden="true"></div>
    <div class="monitor-overlay">
      <p class="monitor-label" data-monitor-label>{first.label}</p>
      <strong data-monitor-title>{first.title}</strong>
      <p data-monitor-copy>{first.lines.join(" · ")}</p>
      <span class="monitor-links" data-monitor-links>
        {first.links.map((link) => (
          <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>{link.label}</a>
        ))}
      </span>
    </div>
  </div>
  <figcaption><strong data-monitor-caption-title>{first.title}</strong><span data-monitor-caption>{first.caption}</span></figcaption>
</figure>

<script>
  import "../scripts/gallery.js";
</script>
