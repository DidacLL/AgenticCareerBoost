---
import type { CollectionEntry } from "astro:content";
import { siteFor } from "../data/site";
import { defaultLocale, localContentId, type Locale } from "../lib/i18n";
import { asset, paths } from "../lib/paths";

const { project, compact = false, locale = defaultLocale } = Astro.props as {
  project: CollectionEntry<"projects">;
  compact?: boolean;
  locale?: Locale;
};
const site = siteFor(locale);
---

<a class:list={["preview-row", { "is-compact": compact }]} href={paths.project(localContentId(project.id), locale)}>
  <span class="preview-row__media"><img src={asset(project.data.image)} alt={project.data.imageAlt} loading="lazy" decoding="async" /></span>
  <span class="preview-row__copy">
    <p class="system-label">{project.data.label ?? site.ui.project} · {project.data.status ?? site.ui.publicRecord}</p>
    <h3>{project.data.title} <span aria-hidden="true">→</span></h3>
    <p>{project.data.summary}</p>
    <ul class="tag-list">{project.data.tags.map((tag) => <li>{tag}</li>)}</ul>
  </span>
</a>
