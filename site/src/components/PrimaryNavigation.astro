---
import { siteFor, type NavId } from "../data/site";
import { defaultLocale, type Locale } from "../lib/i18n";
import { paths } from "../lib/paths";

interface Props {
  activeNav?: NavId;
  variant: "rail" | "tabs";
  locale?: Locale;
}

const { activeNav, variant, locale = defaultLocale } = Astro.props;
const site = siteFor(locale);
---

<nav class:list={["primary-nav", `primary-nav--${variant}`]} aria-label={site.ui.primaryNavigation}>
  {site.navigation.map((item) => (
    <a class:list={{ "is-active": activeNav === item.id }} href={paths.nav(item.id, locale)} aria-current={activeNav === item.id ? "page" : undefined}>
      <span aria-hidden="true">{item.number}</span>
      <strong>{item.label}</strong>
    </a>
  ))}
</nav>
