---
import type { CollectionEntry } from "astro:content";
import DocumentLayout from "./DocumentLayout.astro";
import { siteFor } from "../data/site";
import { dateLocales, defaultLocale, type Locale } from "../lib/i18n";
import { asset } from "../lib/paths";

const { post, locale = defaultLocale } = Astro.props as { post: CollectionEntry<"posts">; locale?: Locale };
const site = siteFor(locale);
const date = post.data.date.toLocaleDateString(dateLocales[locale]);
const meta = [{ term: site.ui.date, value: date }];
if (post.data.tags.length) meta.push({ term: site.ui.tags, value: post.data.tags.join(" · ") });
---

<DocumentLayout
  title={post.data.title}
  description={post.data.description}
  label={site.ui.article}
  subtitle={date}
  activeNav="blog"
  ogType="article"
  meta={meta}
  locale={locale}
>
  {post.data.image && (
    <section class="section-block">
      <h2>{site.ui.image}</h2>
      <div class="section-content"><figure class="media-frame"><img src={asset(post.data.image)} alt={post.data.imageAlt ?? post.data.title} loading="eager" decoding="async" /></figure></div>
    </section>
  )}
  <section class="section-block">
    <h2>{site.ui.note}</h2>
    <div class="section-content prose"><slot /></div>
  </section>
</DocumentLayout>
