---
import BaseLayout from "./BaseLayout.astro";
interface Props { title: string; description: string; label: string; subtitle?: string; activePath?: string; }
const { title, description, label, subtitle, activePath } = Astro.props;
---
<BaseLayout title={title} description={description} activePath={activePath}>
  <p class="breadcrumb"><a href={import.meta.env.BASE_URL}>Home</a> / {label}</p>
  <header class="doc-header"><p class="os-label">{label}</p><h2>{title}</h2>{subtitle && <p>{subtitle}</p>}</header>
  <slot />
</BaseLayout>
